    },
    "geometry": {
      "rotation_center": "coordinate centroid",
      "continuous": true,
      "preserve_spot_identity": true,
      "preserve_spot_count": true,
      "prohibit_grid_snapping": true,
      "prohibit_collision_deletion": true,
      "inverse_tolerance": 1e-8
    },
    "methods": {
      "PASTE": {"alpha": 0.1, "outer_max_iterations": 200, "positive_inner_and_outer_convergence_required": true},
      "Spateo": {"device": "cuda", "iterations": 200, "convergence_claim": false}
    }
  },
  "rng": {
    "public_seed": 2026,
    "requirement": "simulation and method provenance retain effective seeds and exact input/output hashes"
  },
  "solver": {
    "PASTE": "all 20 rows have positive inner-EMD and outer conditional-gradient convergence evidence",
