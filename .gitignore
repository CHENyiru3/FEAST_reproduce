__pycache__/
*.py[cod]
.pytest_cache/
.DS_Store

# Preserved superseded local artifacts. Publication-facing paths contain only
# the current candidates declared in PUBLICATION_MANIFEST.json.
.archive/

# Machine-local configuration and materialized inputs.
site.local.toml
**/data/local/
**/data/**/*.h5ad
**/data/**/*.h5
**/data/**/*.hdf5
**/data/**/*.pt
**/data/**/*.pth
**/data/**/*.ckpt

# Scientific runs are always fresh, local artifacts.
**/outputs/
**/runs/
**/logs/
**/.work/
*.log

# Build artifacts.
dist/
build/
*.whl
*.tar.gz

# Code-only GitHub repository: generated figures include plot tables/provenance.
visualization/**/figures/
visualization/**/candidate_figures/
publication/final_freeze_*/
validation/

# Superseded scripts and machine-local work.
**/archive/
.ruff_cache/
.agents/
.codex/

# Payloads produced if acquisition scripts are run inside the source checkout.
preprocessing/downloads/*/samples/
preprocessing/downloads/*/components/
preprocessing/downloads/*/checksums/
preprocessing/downloads/*/manifest/downloaded_files.tsv
preprocessing/downloads/*/manifest/*_metadata.json
